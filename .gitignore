# Ignore large data + pipeline outputs
data/
artefacts/
makic_artefacts/

# Common large file formats
*.csv
*.tsv
*.parquet
*.pkl
*.hdf5
*.feather

# Powershelll run scripts
*.ps1

# Python cache
__pycache__/
*.pyc

# Python environment
.venv

# Include pipeline configuration
!config/
!config/d_items_keep.csv

# Old generated DML audit and run metadata files
/initial_dml_artefacts/**/policy_dml_model_audit.json
/initial_dml_artefacts/**/policy_dml_run_metadata.json
